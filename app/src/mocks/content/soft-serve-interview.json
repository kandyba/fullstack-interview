const orders = [
  { id: 1, user: 'Yevhen', product: 'apple', price: 10, quantity: 2 },
  { id: 2, user: 'Anna', product: 'banana', price: 5, quantity: 5 },
  { id: 3, user: 'Yevhen', product: 'orange', price: 8, quantity: 1 },
  { id: 4, user: 'Anna', product: 'apple', price: 10, quantity: 1 },
  { id: 5, user: 'Oleg', product: 'banana', price: 5, quantity: 2 },
];

// Задача 1 - Написати функцію яка приймає список замовлень та повертає об'єкт з покупцями та загальною сумою їх покупок

function totalSum(arr) {
  return arr.reduce((total, order) => {
    const user = order.user;

    if (!total[user]) {
      total[user] = {
        total: 0,
        products: [],
      };
    }

    total[user] = {
      total: (total[user] || 0) + order.price * order.quantity,
      products: total.products.push(order.product),
    };

    return total;
  }, {});
}

